# ── New Feed Integrations ──────────────────────────────────────────────────
# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_from_fred.stlouisfed.org
# EIA — https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_key_from_eia.gov
# Finnhub — https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key
# AviationStack — https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=your_aviationstack_key
# ICAO — https://applications.icao.int/dataservices
ICAO_API_KEY=your_icao_key
# Cloudflare Radar — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_radar_token
# AlienVault OTX — https://otx.alienvault.com/api
ALIENVAULT_OTX_KEY=your_otx_key_from_otx.alienvault.com
# AbuseIPDB — https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_key
# HAPI — https://hapi.humdata.org
HAPI_APP_IDENTIFIER=goe-intelligence-platform
# OREF — Optional residential proxy for bypassing WAF
OREF_PROXY_URL=

# ── MiroFish Swarm Intelligence Plugin ──
MIROFISH_ENABLED=false
MIROFISH_URL=http://localhost:5001
MIROFISH_API_KEY=          # optional bearer token
MIROFISH_NUM_AGENTS=500
MIROFISH_SIMULATION_ROUNDS=10
MIROFISH_TIMEOUT_SECONDS=120
MIROFISH_ZEP_API_KEY=      # get free tier at https://app.getzep.com/
